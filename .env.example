# Copy to .env.local and fill in. All values are read on the server only.

# Active provider (currently only: openai)
AI_PROVIDER=openai
OPENAI_API_KEY=sk-proj1212
OPENAI_MODEL=gpt-4o-mini

# Optional: Azure OpenAI / proxy / gateway endpoint
# OPENAI_BASE_URL=
# Optional: json_schema (default) | json_object | prompt
# OPENAI_STRUCTURED_OUTPUT=json_schema


# --- Shared tuning (optional) -------------------------------------------
# Per-request timeout for each model call, in ms (default 120000)
# AI_TIMEOUT_MS=120000
# Automatic retries on transient errors / rate limits (default 2)
# AI_MAX_RETRIES=2
# Sampling temperature. Leave unset for models that only accept the default (e.g. reasoning models).
# AI_TEMPERATURE=0.3

# --- Documents (optional) -----------------------------------------------
# LETTER (default) or A4
# PDF_PAGE_SIZE=LETTER
# Minutes generated PDFs stay downloadable from server memory (default 30)
# DOCUMENT_TTL_MINUTES=30
